<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    app:startDestination="@id/feedFragment">

    <fragment
        android:id="@+id/feedFragment"
        android:name="ru.netology.nework.ui.feed.FeedFragment"
        android:label="NeWork"
        tools:layout="@layout/fragment_feed">

        <action
            android:id="@+id/action_feed_to_newPost"
            app:destination="@id/newPostFragment" />

        <action
            android:id="@+id/action_feed_to_postDetail"
            app:destination="@id/postDetailFragment" />

    </fragment>

    <fragment
        android:id="@+id/newPostFragment"
        android:name="ru.netology.nework.ui.post.NewPostFragment"
        android:label="New Post"
        tools:layout="@layout/fragment_new_post" />

    <fragment
        android:id="@+id/postDetailFragment"
        android:name="ru.netology.nework.ui.post.PostDetailFragment"
        android:label="Post Detail"
        tools:layout="@layout/fragment_post_detail" />

    <fragment
        android:id="@+id/loginFragment"
        android:name="ru.netology.nework.ui.auth.LoginFragment"
        android:label="Login">

        <action
            android:id="@+id/action_loginFragment_to_feedFragment"
            app:destination="@id/feedFragment" />

    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="ru.netology.nework.ui.auth.RegisterFragment"
        android:label="Registration" />

    <fragment
        android:id="@+id/usersFragment"
        android:name="ru.netology.nework.ui.users.UsersFragment"
        android:label="Users"
        tools:layout="@layout/fragment_users">

        <action
            android:id="@+id/action_users_to_userDetail"
            app:destination="@id/userDetailFragment" />

    </fragment>

    <fragment
        android:id="@+id/eventsFragment"
        android:name="ru.netology.nework.ui.events.EventsFragment"
        android:label="Events"
        tools:layout="@layout/fragment_events">

        <action
            android:id="@+id/action_events_to_newEvent"
            app:destination="@id/newEventFragment" />

        <action
            android:id="@+id/action_events_to_eventDetail"
            app:destination="@id/eventDetailFragment" />

    </fragment>

    <fragment
        android:id="@+id/newEventFragment"
        android:name="ru.netology.nework.ui.events.NewEventFragment"
        android:label="New Event"
        tools:layout="@layout/fragment_new_event" />

    <fragment
        android:id="@+id/eventDetailFragment"
        android:name="ru.netology.nework.ui.events.EventDetailFragment"
        android:label="Event Detail"
        tools:layout="@layout/fragment_event_detail" />

    <fragment
        android:id="@+id/locationPickerFragment"
        android:name="ru.netology.nework.ui.post.LocationPickerFragment"
        android:label="Selecting a location"
        tools:layout="@layout/fragment_location_picker" />

    <fragment
        android:id="@+id/userSelectionFragment"
        android:name="ru.netology.nework.ui.users.UserSelectionFragment"
        android:label="Choose users"
        tools:layout="@layout/fragment_user_selection" />

    <fragment
        android:id="@+id/usersListFragment"
        android:name="ru.netology.nework.ui.users.UsersListFragment"
        android:label="UsersListFragment"
        tools:layout="@layout/fragment_users" />

    <fragment
        android:id="@+id/userDetailFragment"
        android:name="ru.netology.nework.ui.users.UserDetailFragment"
        android:label="User Detail"
        tools:layout="@layout/fragment_user_detail">

        <argument
            android:name="user_id"
            app:argType="long" />

        <argument
            android:name="user"
            app:argType="ru.netology.nework.model.User"
            android:defaultValue="@null" />

    </fragment>

</navigation>