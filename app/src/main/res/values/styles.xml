<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Тема приложения -->
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- твои базовые настройки -->
    </style>

    <!-- Анимация для PopupWindow -->
    <style name="PopupAnimation">
        <item name="android:windowEnterAnimation">@anim/slide_in_right</item>
        <item name="android:windowExitAnimation">@anim/slide_out_right</item>
    </style>

    <style name="PopupGrowAnimation">
        <item name="android:windowEnterAnimation">@anim/grow_from_corner</item>
        <item name="android:windowExitAnimation">@anim/shrink_to_corner</item>
    </style>
    <style name="PopupExpandDownAnimation">
        <item name="android:windowEnterAnimation">@anim/expand_down</item>
        <item name="android:windowExitAnimation">@anim/collapse_up</item>
    </style>

    <style name="CircleImageStyle">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

</resources>