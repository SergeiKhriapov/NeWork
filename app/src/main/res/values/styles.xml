<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Тема приложения -->
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- твои базовые настройки -->
    </style>

    <!-- Анимация для PopupWindow -->
    <style name="PopupAnimation">
        <item name="android:windowEnterAnimation">@anim/slide_in_right</item>
        <item name="android:windowExitAnimation">@anim/slide_out_right</item>
    </style>

    <style name="PopupGrowAnimation">
        <item name="android:windowEnterAnimation">@anim/grow_from_corner</item>
        <item name="android:windowExitAnimation">@anim/shrink_to_corner</item>
    </style>
    <style name="PopupExpandDownAnimation">
        <item name="android:windowEnterAnimation">@anim/expand_down</item>
        <item name="android:windowExitAnimation">@anim/collapse_up</item>
    </style>

    <style name="CircleImageStyle">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
    <style name="NavTextStyle" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:fontFamily">sans-serif-medium</item> <!-- semi-bold -->
        <item name="android:textSize">12sp</item>
        <item name="android:lineSpacingExtra">4sp</item> <!-- 12 + 4 = 16sp line-height -->
        <item name="android:includeFontPadding">false</item> <!-- убирает лишние отступы -->
        <item name="android:letterSpacing">0.04</item> <!-- ≈0.5px при 12sp -->
    </style>

</resources>